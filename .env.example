# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env
#
# When deploying to Streamlit Community Cloud, put the same keys in
# `.streamlit/secrets.toml` instead (Streamlit exposes top-level secrets as
# environment variables, so the app reads them the same way).

# --- Required ---------------------------------------------------------------

# Your OpenAI API key (https://platform.openai.com/api-keys), or the key issued
# by your institution's OpenAI-compatible gateway.
OPENAI_API_KEY=sk-...

# --- Optional ---------------------------------------------------------------

# Only set this if you are NOT talking to api.openai.com directly — e.g. an
# institutional proxy that speaks the standard OpenAI v1 API.
# OPENAI_BASE_URL=https://your-institution.example.edu/openai/v1

# OpenAI organization / project scoping. Leave unset for the account defaults.
# OPENAI_ORG_ID=org-...
# OPENAI_PROJECT=proj_...

# Model used by every agent in the simulation. Defaults to gpt-4.1.
# OPENAI_MODEL=gpt-4.1

# Which API surface the Agents SDK calls: "chat_completions" (default, widest
# compatibility — including most gateways) or "responses".
# OPENAI_API_MODE=chat_completions

# --- Tracing ----------------------------------------------------------------

# Agent tracing is off. Setting this to false would export full agent traces to
# platform.openai.com (always there, never to OPENAI_BASE_URL).
OPENAI_TRACING_DISABLED=true
